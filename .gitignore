# Compiled binaries from cmd/rag and cmd/ingest
/rag
/ingest
/interop

# Go build and test artifacts
*.exe
*.test
*.out
/dist/

# Rust build artifacts (Go -> Rust port; Cargo.lock is committed for the binaries).
# Unanchored so a nested rust/target/ is ignored too, before and after RUST-007
# moves the package to the repository root.
target/

# Local environment overrides (config is read from env vars)
.env
.env.*
!.env.example
*.Local.*

# Editor and OS files
.DS_Store
*.swp
.idea/
.vscode/

# Over-engineering audit report, written by .agents/scripts/audit-agent.sh
AUDIT.md*
